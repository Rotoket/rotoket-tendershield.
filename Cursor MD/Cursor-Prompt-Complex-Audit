                        <div className="problem-title">{problem.title}</div>
                        <div className="problem-description">{problem.description}</div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div className="empty-state">✓ Критичных проблем не выявлено</div>
                )}
              </div>
            )}
          </div>

          {/* РЕКОМЕНДАЦИИ */}
          <div 
            className="section-card expandable"
            onClick={() => setExpandedSection(expandedSection === 'recommendations' ? '' : 'recommendations')}
          >
            <div className="section-header">
              <h2>💡 РЕКОМЕНДАЦИИ</h2>
              <span className={`expand-icon ${expandedSection === 'recommendations' ? 'open' : ''}`}>▼</span>
            </div>
            
            {(expandedSection === 'recommendations' || expandedSection === '') && (
              <div className="section-content">
                <ol className="recommendations-list">
                  {auditData.analysis.recommendations.map((rec, idx) => (
                    <li key={idx} className="recommendation-item">
                      <span className="rec-number">{idx + 1}</span>
                      <span className="rec-text">{rec}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </div>

        {/* ПРАВАЯ КОЛОННА: ПОЛНЫЙ ОТЧЕТ */}
        <div className="column column-report">
          <div className="section-card full-report">
            <div className="section-header">
              <h2>📋 ПОЛНЫЙ ОТЧЕТ</h2>
            </div>
            
            <div className="section-content report-text">
              {/* Парсирование и красивый вывод markdown-подобного текста */}
              {parseReportText(auditData.analysis.full_text)}
            </div>
            
            <div className="report-footer">
              <button className="btn-primary">📥 Скачать PDF</button>
              <button className="btn-secondary">📧 Отправить</button>
              <button className="btn-secondary">🔄 Обновить анализ</button>
            </div>
          </div>
        </div>
      </div>

      {/* FOOTER */}
      <div className="report-footer-info">
        <p>© Tender Shield Pro | Аудит выполнен: {new Date().toLocaleString('ru-RU')}</p>
      </div>
    </div>
  );
};

// Хелпер функция для парсирования текста
function parseReportText(text: string): JSX.Element {
  const lines = text.split('\n');
  const elements: JSX.Element[] = [];
  
  lines.forEach((line, idx) => {
    if (line.startsWith('## ')) {
      elements.push(<h3 key={idx} className="report-h3">{line.replace('## ', '')}</h3>);
    } else if (line.startsWith('### ')) {
      elements.push(<h4 key={idx} className="report-h4">{line.replace('### ', '')}</h4>);
    } else if (line.startsWith('- ')) {
      elements.push(<li key={idx} className="report-li">{line.replace('- ', '')}</li>);
    } else if (line.startsWith('**') && line.endsWith('**')) {
      elements.push(<strong key={idx} className="report-strong">{line.replace(/\*\*/g, '')}</strong>);
    } else if (line.trim() !== '') {
      elements.push(<p key={idx} className="report-p">{line}</p>);
    }
  });
  
  return <>{elements}</>;
}
