# Использование в коде:
def analyze_tender_document(documents: list[str], use_complex_audit: bool = False) -> str:
    """
    Анализ тендера с использованием Ollama
    
    Args:
        documents: список текстов документов
        use_complex_audit: True для комплексного аудита, False для базового анализа
    """
    
    system_prompt = COMPLEX_AUDIT_SYSTEM_PROMPT if use_complex_audit else TENDER_ANALYSIS_SYSTEM_PROMPT
    
    # Объедини все документы с разделителями
    combined_text = "\n\n--- ДОКУМЕНТ РАЗДЕЛИТЕЛЬ ---\n\n".join(documents)
    
    # Формируй пользовательский промпт
    if use_complex_audit:
        user_prompt = f"""
        Проведи КОМПЛЕКСНЫЙ АУДИТ следующих документов тендера.
        Всего документов загружено: {len(documents)}
        
        Документы:
        {combined_text}
        
        Выдай детальный, структурированный отчет в соответствии с требованиями комплексного аудита.
        """
    else:
        user_prompt = f"""
        Проведи анализ следующих тендерных документов.
        Всего документов загружено: {len(documents)}
        
        Документы:
        {combined_text}
        
        Выдай структурированный отчет в соответствии с требованиями анализа.
        """
    
    # Вызов Ollama
    response = call_ollama(
        model="qwen2.5:0.5b",  # или твоя модель
        system=system_prompt,
        user_prompt=user_prompt,
        temperature=0.3,  # Низкая температура для точности
        top_p=0.9,
        top_k=40
    )
    
    return response
