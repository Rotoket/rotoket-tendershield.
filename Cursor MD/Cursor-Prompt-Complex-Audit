## ⚡ ЧАСТЬ 2: УЛУЧШЕННЫЙ BACKEND ENDPOINT

```python
# backend/api/analysis.py

from fastapi import APIRouter, UploadFile, File, HTTPException
from typing import Optional
import asyncio

router = APIRouter(prefix="/api/analysis", tags=["analysis"])

@router.post("/complex-audit")
async def complex_audit(
    files: list[UploadFile] = File(...),
    department: Optional[str] = None
):
    """
    Комплексный аудит нескольких тендерных документов
    """
    
    if not files or len(files) == 0:
        raise HTTPException(status_code=400, detail="Загрузите минимум 1 документ")
    
    if len(files) > 5:
        raise HTTPException(status_code=400, detail="Максимум 5 документов за раз")
    
    try:
        # Читай все документы
        documents = []
        for file in files:
            content = await file.read()
            text = extract_text_from_file(content, file.filename)  # PDF/DOCX/TXT парсер
            documents.append({
                "name": file.filename,
                "content": text,
                "size": len(content)
            })
        
        # Логирование
        logger.info(f"Аудит {len(documents)} документов от {department or 'Unknown'}")
        
        # Анализ с Ollama (комплексный)
        analysis_text = await analyze_tender_complex(
            documents=[d["content"] for d in documents],
            use_complex_audit=True
        )
        
        # Парсирование результата
        parsed_result = parse_audit_report(analysis_text)
        
        # Сохранение в БД
        audit_record = AuditRecord(
            user_id=current_user.id,
            documents=documents,
            analysis=analysis_text,
            parsed_result=parsed_result,
            department=department,
            risk_level=parsed_result.get("risk_level"),
            verdict=parsed_result.get("verdict")
        )
        db.add(audit_record)
        db.commit()
        
        return {
            "status": "success",
            "audit_id": audit_record.id,
            "documents_analyzed": len(documents),
            "analysis": parsed_result,
            "raw_text": analysis_text
        }
        
    except Exception as e:
        logger.error(f"Ошибка при аудите: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Ошибка анализа: {str(e)}")


async def analyze_tender_complex(documents: list[str], use_complex_audit: bool = True) -> str:
    """
    Асинхронный вызов Ollama для комплексного анализа
    """
    from services.llm_service import analyze_tender_document
    
    # Запусти в thread pool чтобы не блокировать
    loop = asyncio.get_event_loop()
    result = await loop.run_in_executor(
        None,
        analyze_tender_document,
        documents,
        use_complex_audit
    )
    
    return result


def parse_audit_report(report_text: str) -> dict:
    """
    Парсирование отчета для структурированного вывода
    """
    # Простой парсинг секций (можно улучшить)
    parsed = {
        "full_text": report_text,
        "risk_level": extract_risk_level(report_text),
        "verdict": extract_verdict(report_text),
        "score": extract_score(report_text),
        "problems": extract_problems(report_text),
        "recommendations": extract_recommendations(report_text),
    }
    
    return parsed
