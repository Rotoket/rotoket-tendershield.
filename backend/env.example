# ============================================
# БАЗА ДАННЫХ
# ============================================
TENDER_DB_USER=postgres
TENDER_DB_PASSWORD=postgres
TENDER_DB_HOST=localhost
TENDER_DB_PORT=5432
TENDER_DB_NAME=tender_shield

# ============================================
# БЕЗОПАСНОСТЬ (JWT)
# ============================================
# ⚠️ ВАЖНО: Сгенерируйте свой случайный ключ минимум 32 символа!
# Используйте: https://www.lastpass.com/features/password-generator
# Или Python: import secrets; print(secrets.token_urlsafe(64))
TENDER_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
TENDER_ALGORITHM=HS256
TENDER_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ============================================
# YOOKASSA (ПЛАТЕЖИ)
# ============================================
# Инструкция по получению: см. API_KEYS_SETUP.md

# Для тестового режима (разработка):
TENDER_YOOKASSA_SHOP_ID=
TENDER_YOOKASSA_SECRET_KEY=
TENDER_YOOKASSA_TEST_MODE=true

# Для продакшена (раскомментируйте и заполните после получения боевых ключей):
# TENDER_YOOKASSA_SHOP_ID=your_production_shop_id
# TENDER_YOOKASSA_SECRET_KEY=live_your_production_secret_key
# TENDER_YOOKASSA_TEST_MODE=false

# ============================================
# EMAIL (SMTP)
# ============================================
# Инструкция по получению: см. API_KEYS_SETUP.md

# Gmail (рекомендуется для начала):
TENDER_SMTP_HOST=smtp.gmail.com
TENDER_SMTP_PORT=587
TENDER_SMTP_USER=your-email@gmail.com
TENDER_SMTP_PASSWORD=your-app-password-16-chars
TENDER_SMTP_FROM=noreply@tendershield.pro
TENDER_SMTP_USE_TLS=true

# Альтернативы:
# Mail.ru: smtp.mail.ru:587
# Yandex: smtp.yandex.ru:587
# SendGrid/Mailgun: см. документацию сервиса

# ============================================
# OLLAMA (AI)
# ============================================
TENDER_OLLAMA_BASE_URL=http://localhost:11434
TENDER_OLLAMA_MODEL=qwen2.5-coder:7b

# ============================================
# СЕРВЕР
# ============================================
TENDER_API_HOST=0.0.0.0
TENDER_API_PORT=8000

# ============================================
# CORS (для фронтенда)
# ============================================
TENDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Для продакшена добавьте ваш домен:
# TENDER_CORS_ORIGINS=http://localhost:5173,https://tendershield.pro

# ============================================
# REDIS (опционально, для кеширования)
# ============================================
TENDER_REDIS_HOST=localhost
TENDER_REDIS_PORT=6379
TENDER_REDIS_DB=1


























